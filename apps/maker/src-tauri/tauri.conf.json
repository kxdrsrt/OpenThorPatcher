{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenThor Patch Maker",
  "identifier": "org.openthor.maker",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "OpenThor Patch Maker", "width": 1180, "height": 780, "minWidth": 940, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Publish a Ragnarok Online master client as a patch site",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
